# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- PostgreSQL ------------------------------------------------------------
DATABASE_URL=postgresql://outreach:outreach@localhost:5432/outreach

# --- Redis (BullMQ backend) ------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Gmail SMTP ------------------------------------------------------------
# IMPORTANT: SMTP_PASSWORD must be a Gmail APP PASSWORD, not your normal
# Google account password.
#
# Google disabled plain-password SMTP ("less secure apps") — a normal password
# will simply fail to authenticate. An App Password is a 16-character token
# scoped to a single application and revocable without changing your real
# password.
#
# To generate one:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Visit https://myaccount.google.com/apppasswords
#   3. Create an app password for "Mail" and paste it below (spaces optional).
#
# This value is redacted from all logs. Never share or commit it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=

# Envelope identity shown to recipients.
MAIL_FROM_NAME=Raghuraj Pratap Singh
MAIL_FROM_EMAIL=your.address@gmail.com
MAIL_REPLY_TO=your.address@gmail.com

# --- Sending limits --------------------------------------------------------
# Gmail's practical ceiling is ~500 recipients/day for consumer accounts.
# These defaults are deliberately conservative and stay well under it — they
# are NOT tuned to find Gmail's actual limit, and should not be raised to
# push a personal account harder.
EMAILS_PER_MINUTE=20
EMAIL_DELAY_MS=2000
MAX_CONCURRENT_EMAILS=1
EMAIL_JOB_TIMEOUT_MS=30000
EMAIL_DAILY_CAP=400
EMAIL_MAX_ATTEMPTS=5

# Global kill switch. When true, NOTHING is ever handed to SMTP, regardless of
# per-campaign settings. Keep true until you have previewed real output.
DRY_RUN=true

# --- API rate limiting -----------------------------------------------------
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW=1 minute
